# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the derived auth-token signing secret (recommended)
# AUTH_TOKEN_SECRET=

# Cloudflare R2 presigned uploads (admin uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Web Push (VAPID) — public key is read by the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Prisma (legacy/CLI only — runtime uses Supabase)
DATABASE_URL=