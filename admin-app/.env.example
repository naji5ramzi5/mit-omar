# Supabase (required — admin uses the service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the derived auth-token signing secret (recommended)
# AUTH_TOKEN_SECRET=

# Cloudflare R2 presigned uploads (course images etc.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Web Push (VAPID) — required for the push notification feature
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=